# Salin ke .env.production (tidak di-commit), isi, lalu:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Domain toko. Domain asli = HTTPS otomatis (DNS harus sudah mengarah ke server, port 80/443 terbuka).
# "localhost" untuk mencoba di komputer sendiri (sertifikat lokal Caddy, browser akan memberi peringatan).
SITE_ADDRESS=localhost
# Alamat web untuk tautan di email (reset password, undangan pegawai)
APP_URL=https://localhost

# Password database dan rahasia JWT: buat acak, mis. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=ganti-password-database
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Chatbot AI (opsional, ADR-0006). Kosong = mode FAQ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Email lupa password dan undangan pegawai (ADR-0009). Kosong = email hanya tercetak di log API (tidak terkirim).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Suwandi SecondBranded <no-reply@toko.example.com>
