# Salin ke apps/api/.env (tidak di-commit). Divalidasi di src/config/env.ts saat start.
NODE_ENV=development
PORT=3000
# Sesuai docker-compose.yml di root. Postgres lokal tanpa Docker: ganti user/password.
DATABASE_URL=postgresql://ssb:ssb@localhost:5432/ssb?schema=public
# Minimal 32 karakter acak, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Alamat web untuk tautan di email (reset password)
APP_URL=http://localhost:5173

# Folder unggahan (foto produk, bukti transfer). Sudah di .gitignore.
UPLOAD_DIR=uploads

# Jumlah reverse proxy di depan API. Produksi di belakang Caddy/Nginx: 1 (IP asli pengunjung untuk rate limit chatbot).
TRUST_PROXY=0

# Chatbot AI (Google Gemini, ADR-0006). Ambil key di https://aistudio.google.com/apikey.
# Biarkan kosong untuk mode FAQ (tanpa AI): chatbot hanya menjawab dari FAQ dan pencarian sederhana.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Email: lupa password, undangan pegawai, reset oleh owner (ADR-0009).
# Kosongkan SMTP_HOST untuk mencetak email ke log API saja (dev). Dev dengan Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025.
# Produksi: SMTP penyedia email (mis. Gmail app password, Brevo, Mailgun). Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Suwandi SecondBranded <no-reply@localhost>
