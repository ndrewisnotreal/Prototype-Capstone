# Satu origin untuk web + API (ADR-0003): cookie login httpOnly hanya jalan bila web dan /api di domain yang sama.
# SITE_ADDRESS = domain asli (HTTPS otomatis dari Let's Encrypt), atau "localhost" untuk mencoba (sertifikat lokal Caddy).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	handle /api/* {
		# unggahan foto produk: maks 6 foto x 5 MB
		request_body {
			max_size 40MB
		}
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# file hasil build Vite memakai hash di nama, aman di-cache lama
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
